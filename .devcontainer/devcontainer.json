{
  // Ein Codespace, in dem der Trainer von selbst läuft.
  //
  // Der Zweck ist ein Blick, kein Betrieb: wer auf »Open in Codespaces«
  // drückt, soll nach dem Bau eine gefüllte Oberfläche sehen und nicht
  // eine leere Datenbank mit der Frage, wie man sie befüllt. Darum
  // BEISPIELDATEN=1 — es wirkt ohnehin nur, wenn noch kein Profil da
  // ist (siehe backend/erstbefuellung.py).
  "name": "Donat",

  // Dasselbe Python wie im Abbild. Zwei Fassungen für dasselbe
  // Programm sind eine Fehlerquelle, die niemand sucht.
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",

  "features": {
    // Nur für tests/test_oberflaeche.py: `node --check` auf die
    // JS-Module. Ohne node überspringt der Test sich selbst, aber dann
    // prüft im Codespace niemand die Oberfläche.
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },

    // Damit `gh codespace ssh` und `gh codespace logs` funktionieren.
    // Ohne sshd antwortet beides nur mit der Bitte, genau diese Zeilen
    // hier einzutragen — und dann ist von außen nicht nachzusehen, ob
    // der Trainer überhaupt läuft.
    "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
  },

  "onCreateCommand": "pip install --user -r requirements.txt -r requirements-test.txt",

  // postSTARTCommand, nicht postAttachCommand.
  //
  // »attach« läuft bei JEDEM Verbinden eines Clients: wer den Reiter
  // schließt und neu öffnet, startet ein zweites uvicorn auf demselben
  // Anschluss — der zweite stirbt mit »address already in use«, und im
  // Protokoll steht ein Fehler, der keiner ist. »start« läuft einmal
  // je Start des Containers, und das ist die Lebensdauer, die der
  // Dienst haben soll. Außerdem läuft er dann auch, wenn niemand im
  // Browser angedockt ist — sonst ist von außen nicht nachzusehen, ob
  // er überhaupt hochkommt.
  //
  // BEISPIELDATEN steht HIER und nicht in containerEnv: als Teil der
  // Umgebung gälte es auch für `pytest` im Terminal, und dann entstünde
  // der Beispielbestand in jeder Testdatenbank. Gemessen waren das 40
  // Fehlschläge — das Demoprofil bekommt die 1, und Tests, die mit
  // benutzer_id=1 ihr eigenes Profil meinen, prüfen fremde Rechte.
  // (Die conftest entfernt die Variable zusätzlich; zwei Riegel, weil
  // der eine im Codespace und der andere überall wirkt.)
  "postStartCommand": "nohup env BEISPIELDATEN=1 python -m uvicorn app:app --app-dir backend --host 0.0.0.0 --port 8030 > /tmp/donat.log 2>&1 &",

  "forwardPorts": [8030],
  "portsAttributes": {
    "8030": {
      "label": "Donat",
      "onAutoForward": "openBrowser"
    }
  },

  "containerEnv": {
    // Die Datenbank im Arbeitsbereich, nicht unter /daten: im
    // Codespace gibt es kein eingehängtes Verzeichnis, und /daten
    // gehört dort niemandem.
    "VOKABEL_DB": "${containerWorkspaceFolder}/daten/vokabeltrainer.db",
    "PYTHONDONTWRITEBYTECODE": "1"
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  }
}
